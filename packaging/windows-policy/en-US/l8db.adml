<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>l8db</displayName>
  <description>l8db</description>
  <resources>
    <stringTable>
      <string id="L8db">l8db</string>
      <string id="Microsoft">Team connections via Microsoft 365</string>
      <string id="Microsoft_Help">Enabled: l8db offers sign-in with the work account on startup and loads shared connections from the SharePoint site. Disabled: no Microsoft sign-in through this policy.</string>
      <string id="MicrosoftSiteUrl">SharePoint site for team connections</string>
      <string id="MicrosoftSiteUrl_Help">Full address, e.g. https://contoso.sharepoint.com/sites/l8db. Recommended so no other site with the same name is used.</string>
      <string id="MicrosoftScope">Permission scope</string>
      <string id="MicrosoftScope_Help">all: Sites.Read.All. selected: only Sites.Selected; requires the site address and granting the app access to the site.</string>
      <string id="ScopeAll">All readable sites (Sites.Read.All)</string>
      <string id="ScopeSelected">Assigned site only (Sites.Selected)</string>
      <string id="MicrosoftTenant">Restrict organisation</string>
      <string id="MicrosoftTenant_Help">Directory ID or domain. Restricts sign-in to this organisation.</string>
      <string id="MicrosoftClientId">Own app registration</string>
      <string id="MicrosoftClientId_Help">Application ID of your own public client registration instead of the l8db project app.</string>
      <string id="HubUrl">Own team hub</string>
      <string id="HubUrl_Help">https address of a self-hosted team hub. Ignored when Microsoft 365 is enabled.</string>
      <string id="AllowedHosts">Allowed database hosts</string>
      <string id="AllowedHosts_Help">Semicolon separated, e.g. *.contoso.local;db01. Team connections to other hosts are ignored.</string>
    </stringTable>
    <presentationTable>
      <presentation id="MicrosoftSiteUrl"><textBox refId="MicrosoftSiteUrl"><label>SharePoint site for team connections</label></textBox></presentation>
      <presentation id="MicrosoftTenant"><textBox refId="MicrosoftTenant"><label>Restrict organisation</label></textBox></presentation>
      <presentation id="MicrosoftClientId"><textBox refId="MicrosoftClientId"><label>Own app registration</label></textBox></presentation>
      <presentation id="HubUrl"><textBox refId="HubUrl"><label>Own team hub</label></textBox></presentation>
      <presentation id="AllowedHosts"><textBox refId="AllowedHosts"><label>Allowed database hosts</label></textBox></presentation>
      <presentation id="MicrosoftScope"><dropdownList refId="MicrosoftScope" defaultItem="0">Permission scope</dropdownList></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
