<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>l8db</displayName>
  <description>l8db</description>
  <resources>
    <stringTable>
      <string id="L8db">l8db</string>
      <string id="Microsoft">Team-Verbindungen über Microsoft 365</string>
      <string id="Microsoft_Help">Aktiviert: l8db bietet beim Start die Anmeldung mit dem Firmenkonto an und lädt die freigegebenen Verbindungen aus der SharePoint-Website. Deaktiviert: keine Microsoft-Anmeldung über diese Richtlinie.</string>
      <string id="MicrosoftSiteUrl">SharePoint-Website für Team-Verbindungen</string>
      <string id="MicrosoftSiteUrl_Help">Vollständige Adresse, z. B. https://firma.sharepoint.com/sites/l8db. Empfohlen, damit keine andere Website gleichen Namens verwendet wird.</string>
      <string id="MicrosoftScope">Berechtigungsumfang</string>
      <string id="MicrosoftScope_Help">all: Sites.Read.All. selected: nur Sites.Selected; erfordert die Website-Adresse und eine Zuweisung der App zur Website.</string>
      <string id="ScopeAll">Alle lesbaren Websites (Sites.Read.All)</string>
      <string id="ScopeSelected">Nur zugewiesene Website (Sites.Selected)</string>
      <string id="MicrosoftTenant">Organisation festlegen</string>
      <string id="MicrosoftTenant_Help">Verzeichnis-ID oder Domain. Beschränkt die Anmeldung auf diese Organisation.</string>
      <string id="MicrosoftClientId">Eigene App-Registrierung</string>
      <string id="MicrosoftClientId_Help">Anwendungs-ID einer eigenen öffentlichen App-Registrierung statt der App des l8db-Projekts.</string>
      <string id="HubUrl">Eigener Team-Hub</string>
      <string id="HubUrl_Help">https-Adresse eines selbst betriebenen Team-Hubs. Wird ignoriert, wenn Microsoft 365 aktiviert ist.</string>
      <string id="AllowedHosts">Erlaubte Datenbank-Hosts</string>
      <string id="AllowedHosts_Help">Durch Semikolon getrennt, z. B. *.firma.intern;db01. Team-Verbindungen zu anderen Hosts werden ignoriert.</string>
    </stringTable>
    <presentationTable>
      <presentation id="MicrosoftSiteUrl"><textBox refId="MicrosoftSiteUrl"><label>SharePoint-Website für Team-Verbindungen</label></textBox></presentation>
      <presentation id="MicrosoftTenant"><textBox refId="MicrosoftTenant"><label>Organisation festlegen</label></textBox></presentation>
      <presentation id="MicrosoftClientId"><textBox refId="MicrosoftClientId"><label>Eigene App-Registrierung</label></textBox></presentation>
      <presentation id="HubUrl"><textBox refId="HubUrl"><label>Eigener Team-Hub</label></textBox></presentation>
      <presentation id="AllowedHosts"><textBox refId="AllowedHosts"><label>Erlaubte Datenbank-Hosts</label></textBox></presentation>
      <presentation id="MicrosoftScope"><dropdownList refId="MicrosoftScope" defaultItem="0">Berechtigungsumfang</dropdownList></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
