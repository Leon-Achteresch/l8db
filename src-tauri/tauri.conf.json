{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "l8db",
  "version": "0.1.0",
  "identifier": "com.leon.l8db",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "l8db",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Leon-Achteresch/l8db/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY_SEE_docs_RELEASE_md"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Leon Achteresch",
    "category": "DeveloperTool",
    "shortDescription": "l8db",
    "longDescription": "l8db is a fast, native desktop client for PostgreSQL and other databases.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
