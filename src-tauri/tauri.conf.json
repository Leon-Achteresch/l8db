{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "l8db",
  "version": "0.7.0",
  "identifier": "com.leon.l8db",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run production:check && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "l8db",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 25
        },
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: https://github.com/Leon-Achteresch/l8db/releases/download/ https://release-assets.githubusercontent.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http: https:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' https://l8db.leon-achteresch.de",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "media-src": "'self' https://github.com/Leon-Achteresch/l8db/releases/download/ https://release-assets.githubusercontent.com"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: https://github.com/Leon-Achteresch/l8db/releases/download/ https://release-assets.githubusercontent.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http: https: ws: wss:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' https://l8db.leon-achteresch.de http://localhost:3000",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "media-src": "'self' https://github.com/Leon-Achteresch/l8db/releases/download/ https://release-assets.githubusercontent.com"
      },
      "freezePrototype": false,
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Leon-Achteresch/l8db/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQ0E1MjBEMzUzREExMjIKUldRaW9UMDFEVkxLcXhrRE15cGsvRlFJaU5keTk1SXRsVy9Ib3RqVlROenZZTm5LVW9kZGZsdDMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Leon Achteresch",
    "category": "DeveloperTool",
    "shortDescription": "Native database client for PostgreSQL and other databases",
    "longDescription": "l8db is a fast, native desktop client for PostgreSQL and other databases.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/Leon-Achteresch/l8db",
    "license": "Elastic-2.0",
    "fileAssociations": [
      {
        "ext": ["sqlite", "sqlite3", "db", "db3"],
        "name": "SQLite-Datenbank",
        "description": "SQLite-Datenbank",
        "mimeType": "application/vnd.sqlite3",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["duckdb", "ddb"],
        "name": "DuckDB-Datenbank",
        "description": "DuckDB-Datenbank",
        "mimeType": "application/x-duckdb",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["parquet"],
        "name": "Parquet-Datei",
        "description": "Parquet-Datei",
        "mimeType": "application/vnd.apache.parquet",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["csv"],
        "name": "CSV-Datei",
        "description": "CSV-Datei",
        "mimeType": "text/csv",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["sql"],
        "name": "SQL-Skript",
        "description": "SQL-Skript",
        "mimeType": "application/sql",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["l8nb"],
        "name": "l8db-Notebook",
        "description": "l8db-Notebook",
        "mimeType": "application/x-l8db-notebook",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.leon.l8db.notebook",
          "conformsTo": ["public.json"]
        }
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/l8db.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/l8db.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
