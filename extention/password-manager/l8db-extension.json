{
  "id": "l8db.password-manager",
  "name": "Passwortmanager-Sync",
  "version": "1.4.1",
  "description": "Speichert deine l8db-Verbindungen in Bitwarden, 1Password oder Keeper und lädt sie von dort, inklusive Zugängen aus geteilten Sammlungen, Tresoren und Ordnern.",
  "publisher": "l8db",
  "engines": {
    "l8db": ">=0.7.0 <1.0.0",
    "api": "^1.1.0"
  },
  "main": "dist/extension.js",
  "activationEvents": [
    "onStartup",
    "onCommand:vault.sync",
    "onCommand:vault.save",
    "onCommand:vault.import",
    "onCommand:vault.export",
    "onCommand:vault.install",
    "onCommand:vault.setup"
  ],
  "permissions": [
    "process:execute",
    "connections:read",
    "connections:write",
    "filesystem:extension-storage"
  ],
  "capabilities": {
    "process": {
      "commands": [
        "keeper",
        "bw",
        "op",
        "pipx",
        "python3",
        "py",
        "npm",
        "brew",
        "winget",
        "sh"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "vault.sync",
        "title": "Passwortmanager: Zugänge abgleichen",
        "icon": "refresh-cw"
      },
      {
        "id": "vault.save",
        "title": "Passwortmanager: Verbindung speichern"
      },
      {
        "id": "vault.export",
        "title": "Passwortmanager: Bestehende Verbindungen speichern"
      },
      {
        "id": "vault.import",
        "title": "Passwortmanager: Ausgeblendete Verbindungen einblenden"
      },
      {
        "id": "vault.install",
        "title": "Passwortmanager: CLI installieren"
      },
      {
        "id": "vault.setup",
        "title": "Passwortmanager: Einrichtung"
      }
    ],
    "configuration": {
      "vault.provider": {
        "type": "string",
        "default": "keeper",
        "enum": [
          "keeper",
          "bitwarden",
          "1password"
        ],
        "description": "Passwortmanager, dessen CLI verwendet wird (keeper, bw oder op)."
      },
      "vault.autoSync": {
        "type": "boolean",
        "default": true,
        "description": "Datenbank-Zugänge beim Start automatisch aus dem Passwortmanager laden"
      }
    },
    "menus": [
      {
        "command": "vault.sync",
        "location": "palette"
      },
      {
        "command": "vault.export",
        "location": "palette"
      },
      {
        "command": "vault.import",
        "location": "palette"
      },
      {
        "command": "vault.install",
        "location": "palette"
      }
    ],
    "statusBar": [
      {
        "id": "vault.status",
        "alignment": "right",
        "priority": 20
      }
    ]
  }
}
