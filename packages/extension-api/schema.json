{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "l8db Extension Manifest v1",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "publisher",
    "engines",
    "main",
    "activationEvents"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$",
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "description": "Valid Semantic Version, checked by the runtime validator"
    },
    "main": {
      "type": "string",
      "pattern": "^(\\./)?[a-zA-Z0-9_./-]+\\.js$",
      "description": "Safe relative path; parent segments and reserved filenames are rejected by validation"
    },
    "engines": {
      "type": "object",
      "required": [
        "l8db"
      ],
      "properties": {
        "l8db": {
          "type": "string",
          "description": "npm semver range"
        },
        "api": {
          "enum": ["^1.0.0", "^1.1.0"],
          "default": "^1.0.0"
        }
      }
    },
    "activationEvents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^(onStartup|onDatabaseOpen|onCommand:[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}|onView:[a-zA-Z0-9][a-zA-Z0-9._-]{0,127})$"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "database:read",
          "database:write",
          "network",
          "filesystem:extension-storage",
          "filesystem",
          "clipboard:read",
          "clipboard:write",
          "process:execute"
        ]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object",
          "required": ["hosts"],
          "additionalProperties": false,
          "properties": {
            "hosts": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "minLength": 1, "maxLength": 253 }
            }
          }
        },
        "process": {
          "type": "object",
          "required": ["commands"],
          "additionalProperties": false,
          "properties": {
            "commands": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "description": "npm semver range; self dependencies and cycles forbidden"
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "icon": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            }
          }
        },
        "configuration": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "default"
                ],
                "properties": {
                  "type": {
                    "const": "boolean"
                  },
                  "default": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string"
                  },
                  "enum": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": { "type": "boolean" }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "default"
                ],
                "properties": {
                  "type": {
                    "const": "string"
                  },
                  "default": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "enum": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": { "type": "string" }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "default"
                ],
                "properties": {
                  "type": {
                    "const": "number"
                  },
                  "default": {
                    "type": "number"
                  },
                  "description": {
                    "type": "string"
                  },
                  "enum": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": { "type": "number" }
                  }
                }
              }
            ]
          }
        },
        "views": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "title", "location"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "location": { "enum": ["sidebar", "panel"] },
              "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
            }
          }
        },
        "panels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        },
        "statusBar": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
              "alignment": { "enum": ["left", "right"] },
              "priority": { "type": "number" }
            }
          }
        },
        "menus": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["command", "location"],
            "properties": {
              "command": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
              "location": { "enum": ["palette", "view/title", "view/item", "statusBar"] },
              "view": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" },
              "group": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    }
  }
}
