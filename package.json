{
  "name": "l8db",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "description": "Fast, native desktop client for PostgreSQL and other databases.",
  "author": "Leon Achteresch",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Leon-Achteresch/l8db",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leon-Achteresch/l8db.git"
  },
  "bugs": {
    "url": "https://github.com/Leon-Achteresch/l8db/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:ai": "tauri dev --config src-tauri/tauri.ai-dev.conf.json",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:macos:signed": "tauri build --bundles app,dmg --config src-tauri/tauri.signing.conf.json -- --locked",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "test": "bun test tests",
    "test:release": "bun test tests/release-artifacts.test.ts tests/release-integrity.test.ts tests/release-plan.test.ts tests/release-signing.test.ts tests/release-workflows.test.ts tests/packaging-update.test.ts tests/changelog.test.ts tests/version.test.ts",
    "test:browser": "bun scripts/test-browser.ts",
    "test:integration": "bash scripts/test-postgres-ssh.sh",
    "pr:report": "bun scripts/pr-report.ts",
    "test:redis": "node scripts/test-redis-integration.mjs",
    "test:clickhouse": "node scripts/test-clickhouse-browser.mjs",
    "test:http-families": "bash scripts/test-http-families.sh",
    "test:pocketbase": "bash scripts/test-pocketbase-live.sh",
    "test:workload-live": "bash scripts/test-workload-live.sh",
    "test:perf:scroll": "bun run build && L8DB_PERF_BROWSER=1 L8DB_PERF_STYLED=1 L8DB_PERF_DURATION=10000 bun test tests/perf-browser.test.ts",
    "test:perf": "bun run build && L8DB_PERF_BROWSER=1 L8DB_PERF_STYLED=1 L8DB_PERF_APP=1 bun test tests/perf-browser.test.ts tests/perf-bundle.test.ts tests/perf-app.test.ts",
    "version:check": "node scripts/version.mjs check",
    "changelog": "node .github/scripts/generate-changelog.mjs",
    "extension": "bun packages/extension-sdk/src/cli.ts",
    "production:check": "node scripts/production-check.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "feature-videos:record": "bun scripts/feature-videos/record.ts",
    "feature-videos:dashboard-tour": "bun scripts/feature-videos/render-dashboard-tour.ts",
    "feature-videos:plan": "bun scripts/feature-videos/publish.ts plan",
    "feature-videos:cleanup": "bun scripts/feature-videos/publish.ts cleanup"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.80",
    "@sentry/browser": "^11.1.0",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "elkjs": "^0.12.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.1",
    "lucide": "1.48.0",
    "lucide-react": "^1.43.0",
    "monaco-editor": "^0.56.0",
    "monaco-vim": "0.4.4",
    "morphicons": "^1.7.1",
    "motion": "^13.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-grid-layout": "^2.2.4",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.10.1",
    "semver": "^7.8.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^3.7.0",
    "thesvg": "^3.3.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.37",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^8.3.1",
    "shadcn": "^4.21.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "dompurify": "^3.4.16"
  },
  "packageManager": "bun@1.3.10"
}
