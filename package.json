{
  "name": "l8db",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Fast, native desktop client for PostgreSQL and other databases.",
  "author": "Leon Achteresch",
  "license": "MIT",
  "homepage": "https://github.com/Leon-Achteresch/l8db",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leon-Achteresch/l8db.git"
  },
  "bugs": {
    "url": "https://github.com/Leon-Achteresch/l8db/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "check": "biome check ./src",
    "test": "bun test tests",
    "test:perf": "bun run build && L8DB_PERF_BROWSER=1 L8DB_PERF_STYLED=1 L8DB_PERF_APP=1 bun test tests/perf-browser.test.ts tests/perf-bundle.test.ts tests/perf-app.test.ts",
    "version:check": "node scripts/version.mjs check",
    "changelog": "node .github/scripts/generate-changelog.mjs",
    "extension": "bun packages/extension-sdk/src/cli.ts",
    "production:check": "node scripts/production-check.mjs"
  },
  "dependencies": {
