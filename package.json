    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "elkjs": "^0.11.1",
